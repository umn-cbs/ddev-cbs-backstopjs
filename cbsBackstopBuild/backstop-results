#!/usr/bin/env bash

#ddev-generated

## Description: Launch a browser with latest backstop results
## Usage: backstop-results
## Example: "ddev backstop-results"

case $OSTYPE in
  linux-gnu)
    xdg-open "${DDEV_APPROOT}/${DDEV_DOCROOT}/sites/default/backstop/backstop_data/html_report/index.html"
    ;;
  "darwin"*)
    open "${DDEV_APPROOT}/${DDEV_DOCROOT}/sites/default/backstop/backstop_data/html_report/index.html"
    ;;
  "win*"* | "msys"*)
    start "${DDEV_APPROOT}/${DDEV_DOCROOT}/sites/default/backstop/backstop_data/html_report/index.html"
    ;;
esac
